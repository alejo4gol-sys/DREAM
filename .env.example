# ── Copia este archivo como .env y cambia los valores ──
# Genera secretos con:  openssl rand -base64 48   (JWT)   y   openssl rand -base64 32   (cifrado)

POSTGRES_PASSWORD=cambia-esta-clave
DATABASE_URL=postgresql://dream:cambia-esta-clave@localhost:5432/dream
REDIS_URL=redis://localhost:6379

JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio
# 32 bytes en base64 (AES-256-GCM). ¡No lo pierdas: sin él no se pueden descifrar los datos sensibles!
ENCRYPTION_KEY=pon-aqui-32-bytes-en-base64

WEB_ORIGIN=http://localhost:3000
PORT=4000

# Opcional — integraciones (solo cuando tengas apps aprobadas)
# META_APP_ID=
# META_APP_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Asistente de Negocio con IA completa (lenguaje natural). Sin clave responde con tus datos y tu base de conocimiento.
# Crea la clave en https://console.anthropic.com (tiene costo por uso).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Wompi del comercio de DREAM para cobrar los planes de la plataforma.
# Configura también el webhook https://TU_API/api/billing/wompi/webhook en Wompi.
# Usa llaves de prueba (pub_test_/prv_test_) en desarrollo y de producción al publicar.
WOMPI_SAAS_PUBLIC_KEY=
WOMPI_SAAS_PRIVATE_KEY=
WOMPI_SAAS_INTEGRITY_SECRET=
WOMPI_SAAS_EVENT_SECRET=

# Búsqueda de precios de mercado. Cada fuente se habilita al tener sus credenciales oficiales.
# El token de Mercado Libre se obtiene al autorizar la aplicación de DREAMS.
# Las llaves de eBay se crean en su programa de desarrolladores.
MERCADOLIBRE_ACCESS_TOKEN=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
SERPAPI_API_KEY=

# Avisos por WhatsApp (WhatsApp Business Platform, Cloud API de Meta). Sin estas variables los avisos
# solo se muestran dentro de DREAMS. Pasos en docs/WHATSAPP.md.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Dirección pública de DREAMS para los enlaces de los avisos (ej. https://app.dreams.co)
APP_PUBLIC_URL=
# Consulta automática de procesos en la Rama Judicial (true/false)
PROCESS_WATCH_ENABLED=true
