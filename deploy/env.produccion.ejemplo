# Copia este archivo como deploy/.env.produccion en el servidor y llénalo.
# El script scripts/instalar-servidor.sh lo crea por ti con claves aleatorias.

# Tu dominio, sin https ni www (debe apuntar a la IP del servidor)
DOMINIO=midominio.com.co
# Correo para el certificado HTTPS (avisos de Let's Encrypt)
CORREO_SSL=tucorreo@ejemplo.com

# Claves secretas (NO las compartas). Genera cada una con:  openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# Correos que administran la plataforma (verifican abogados, etc.)
PLATFORM_ADMIN_EMAILS=
# WhatsApp de soporte (botón verde en la página), con indicativo: 573001234567
SUPPORT_WHATSAPP=

# Opcionales: pagos de planes (Wompi), WhatsApp, asistente, precios de mercado
WOMPI_SAAS_PUBLIC_KEY=
WOMPI_SAAS_PRIVATE_KEY=
WOMPI_SAAS_INTEGRITY_SECRET=
WOMPI_SAAS_EVENT_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
